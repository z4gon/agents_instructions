{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    // Ask by default; allowlist read-only tools, git/gh inspection, and local edits.
    // Hard-deny .env* read/edit (except .env.example); prompt on external dirs.
    // Keep any command with flag denies in its own section.

    // ─── Defaults ───────────────────────────────────────────────────────────────

    { "action": "*", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "question", "resource": "*", "effect": "allow" },

    // ─── Read-only tools ────────────────────────────────────────────────────────

    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },

    // ─── Shell: git ─────────────────────────────────────────────────────────────

    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git branch", "effect": "allow" }, // local branches
    { "action": "shell", "resource": "git branch -a", "effect": "allow" }, // local + remote
    { "action": "shell", "resource": "git branch -r", "effect": "allow" }, // remote
    { "action": "shell", "resource": "git branch -v", "effect": "allow" }, // + last commit
    { "action": "shell", "resource": "git branch -vv", "effect": "allow" }, // + upstream + commit
    { "action": "shell", "resource": "git branch -av", "effect": "allow" }, // all + last commit
    { "action": "shell", "resource": "git branch -avv", "effect": "allow" }, // all + upstream + commit
    { "action": "shell", "resource": "git branch --show-current", "effect": "allow" },
    { "action": "shell", "resource": "git branch --list *", "effect": "allow" },
    { "action": "shell", "resource": "git branch --merged *", "effect": "allow" },
    { "action": "shell", "resource": "git branch --no-merged *", "effect": "allow" },
    { "action": "shell", "resource": "git branch --contains *", "effect": "allow" },
    { "action": "shell", "resource": "git branch --no-contains *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "git describe *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git shortlog *", "effect": "allow" },
    { "action": "shell", "resource": "git stash list *", "effect": "allow" },
    // Writes fall back to ask

    // ─── Shell: git grep ────────────────────────────────────────────────────────

    { "action": "shell", "resource": "git grep *", "effect": "allow" },
    { "action": "shell", "resource": "git grep -O*", "effect": "deny" }, // executes pager
    { "action": "shell", "resource": "git grep * -O*", "effect": "deny" },
    { "action": "shell", "resource": "git grep --open-files-in-pager*", "effect": "deny" },
    { "action": "shell", "resource": "git grep * --open-files-in-pager*", "effect": "deny" },

    // ─── Shell: GitHub ──────────────────────────────────────────────────────────

    { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr diff *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr list *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr checks *", "effect": "allow" },
    { "action": "shell", "resource": "gh run list *", "effect": "allow" },
    { "action": "shell", "resource": "gh run view *", "effect": "allow" },

    // ─── Subagents ──────────────────────────────────────────────────────────────

    // Others fall back to ask
    { "action": "subagent", "resource": "explore", "effect": "allow" },

    // ─── Read & edit ────────────────────────────────────────────────────────────

    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" }
  ],
  "policies": [
    // Hard-deny .env read/edit across all agents.
    // "allow" only lifts the policy deny; permissions above still allow .env.example.
    { "action": "tool.use", "resource": "edit:*.env", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.env.*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.env.example", "effect": "allow" },
    { "action": "tool.use", "resource": "read:*.env", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env.*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env.example", "effect": "allow" }
  ]
}
