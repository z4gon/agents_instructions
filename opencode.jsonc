{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    // Rationale:
    // - allow read-only actions that don't read sensitive secrets
    // - allow writes/edits that produce or edit a local text file
    // - deny sensitive secret read/edit
    // - deny side effects (exec/delete/mutate) in actions used mainly to read
    // - always ask before working on an external directory
    // - everything else asks

    // ─── Defaults ───────────────────────────────────────────────────────────────

    // Ask by default, allow only what's explicitly listed below.
    { "action": "*", "resource": "*", "effect": "ask" },

    // External directories
    { "action": "external_directory", "resource": "*", "effect": "ask" },

    // Let the agent ask clarifying questions without a permission prompt
    { "action": "question", "resource": "*", "effect": "allow" },

    // ─── Read-only tools ────────────────────────────────────────────────────────

    // Glob and grep tools
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },

    // ─── Shell: file inspection ─────────────────────────────────────────────────

    { "action": "shell", "resource": "glob *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    // awk omitted: it can run system() and redirect output, so it can't be safely allowlisted

    // Deny exec/destructive vectors in the allowed commands (last match wins)
    // find: -exec* covers -execdir, -ok* covers -okdir; plain file writes (-o, -fprint, --output) are allowed
    { "action": "shell", "resource": "find * -exec*", "effect": "deny" },
    { "action": "shell", "resource": "find * -ok*", "effect": "deny" },
    { "action": "shell", "resource": "find * -delete*", "effect": "deny" },
    // sort: --compress-program runs a helper program
    { "action": "shell", "resource": "sort * --compress-program*", "effect": "deny" },
    // rg: --pre runs a command on every file
    { "action": "shell", "resource": "rg * --pre*", "effect": "deny" },

    // ─── Shell: git ─────────────────────────────────────────────────────────────

    // Read-only git
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "git grep *", "effect": "allow" },
    { "action": "shell", "resource": "git describe *", "effect": "allow" },
    { "action": "shell", "resource": "git shortlog *", "effect": "allow" },
    { "action": "shell", "resource": "git stash list *", "effect": "allow" },

    // Deny mutating flags in git branch, grouped by flag
    // delete
    { "action": "shell", "resource": "git branch * -d *", "effect": "deny" },
    { "action": "shell", "resource": "git branch * -D *", "effect": "deny" },
    { "action": "shell", "resource": "git branch * --delete*", "effect": "deny" },
    // rename/move
    { "action": "shell", "resource": "git branch * -m *", "effect": "deny" },
    { "action": "shell", "resource": "git branch * -M *", "effect": "deny" },
    { "action": "shell", "resource": "git branch * --move*", "effect": "deny" },
    // copy
    { "action": "shell", "resource": "git branch * -c *", "effect": "deny" },
    { "action": "shell", "resource": "git branch * --copy*", "effect": "deny" },
    // upstream
    { "action": "shell", "resource": "git branch * -u *", "effect": "deny" },
    { "action": "shell", "resource": "git branch * --set-upstream*", "effect": "deny" },
    { "action": "shell", "resource": "git branch * --unset-upstream*", "effect": "deny" },
    // description
    { "action": "shell", "resource": "git branch * --edit-description*", "effect": "deny" },

    // Writes need approval
    { "action": "shell", "resource": "git add *", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },

    // ─── Shell: GitHub ──────────────────────────────────────────────────────────

    // Read-only GitHub
    { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr diff *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr list *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr checks *", "effect": "allow" },
    { "action": "shell", "resource": "gh run list *", "effect": "allow" },
    { "action": "shell", "resource": "gh run view *", "effect": "allow" },

    // ─── Subagents ──────────────────────────────────────────────────────────────

    // Ask, except explore
    { "action": "subagent", "resource": "*", "effect": "ask" },
    { "action": "subagent", "resource": "explore", "effect": "allow" },

    // ─── Secrets (.env) ─────────────────────────────────────────────────────────

    // Edit: allow, but keep .env files out (last match wins)
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },

    // Reads: allow, but keep .env files out (last match wins)
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },

    // Secrets: shell can't read .env either (*.env* matches .env anywhere in the command);
    // scoped re-allows keep .env.example readable from the shell
    { "action": "shell", "resource": "*.env*", "effect": "deny" },
    { "action": "shell", "resource": "cat *.env.example", "effect": "allow" },
    { "action": "shell", "resource": "head *.env.example", "effect": "allow" },
    { "action": "shell", "resource": "tail *.env.example", "effect": "allow" },
    { "action": "shell", "resource": "grep *.env.example", "effect": "allow" },
    { "action": "shell", "resource": "rg *.env.example", "effect": "allow" }
  ]
}
